# Banco PostgreSQL (Neon, Supabase, RDS ou servidor próprio). Com Neon, use a string "pooled".
DATABASE_URL=postgresql://usuario:senha@host:5432/gestao_processos?sslmode=require

# Segredo do cookie de sessão: 32+ caracteres aleatórios (ex.: openssl rand -hex 32).
AUTH_SECRET=

# Endereço público do sistema, usado nos links enviados por e-mail (sem barra no final).
# Na Vercel, se ficar vazio, usa o domínio de produção do projeto.
APP_URL=https://gestao.famossul.com.br

# Primeiro administrador: entra uma vez com estes dados enquanto não existir administrador com e-mail.
# Precisa ser um e-mail @famossul.com.br. Depois de entrar, troque a senha em "Minha senha".
ADMIN_EMAIL=ti@famossul.com.br
ADMIN_SENHA_INICIAL=

# Envio de e-mail (links de ativação e de recuperação de senha) por SMTP.
# Microsoft 365: smtp.office365.com, porta 587 (SMTP AUTH habilitado na caixa remetente).
# Google Workspace: smtp.gmail.com, porta 587 (senha de app) ou o relay smtp-relay.gmail.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true para a porta 465 (SSL direto). Na 587 o STARTTLS é usado quando o servidor oferece.
SMTP_SECURE=false
# true para exigir STARTTLS na 587 (recomendado em produção).
SMTP_TLS_OBRIGATORIO=true
EMAIL_REMETENTE="Gestão de Processos Famossul <naoresponda@famossul.com.br>"

# Opcionais
# SESSAO_HORAS=12
# FUSO_HORARIO=America/Sao_Paulo
# DB_POOL_MAX=5
